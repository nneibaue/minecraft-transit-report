{
	"schemaVersion": 1,
	"id": "jollyalchemy-transit-report",
	"version": "${version}",
	"name": "Human Design Transit Display",
	"description": "A placeable block that displays a live Human Design transit chart, refreshed on its own and resilient when the API misbehaves.",
	"authors": [
		"Nate Neibauer"
	],
	"contact": {
		"sources": "https://github.com/nneibaue/minecraft-transit-report"
	},
	"license": "CC0-1.0",
	"icon": "assets/jollyalchemy-transit-report/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"transitreport.JollyalchemyTransitReport"
		],
		"client": [
			"transitreport.client.JollyalchemyTransitReportClient"
		],
		"fabric-datagen": [
			"transitreport.client.JollyalchemyTransitReportDataGenerator"
		]
	},
	"mixins": [
		"jollyalchemy-transit-report.mixins.json",
		{
			"config": "jollyalchemy-transit-report.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}