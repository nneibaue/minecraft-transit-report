# Copy this file to .env (git-ignored) and fill in the values below.

# WebSocket server bind address. Leave at 127.0.0.1 for a local dedicated server on this PC.
HOST=127.0.0.1
# WebSocket server listen port.
PORT=8765

# Claude model ID used for chat requests.
MODEL=claude-sonnet-5
# Anthropic API key. Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret devices must present in their hello handshake. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
BRIDGE_TOKEN=

# Comma-separated player names allowed to give the bridge orders; required, at least one.
ALLOWED_PLAYERS=Nate,Friend2

# Chat prefix that triggers the agent.
COMMAND_PREFIX=$robot
# Name shown in Chat Box messages.
ROBOT_NAME=Robot
# Seconds to wait for a device command to finish.
CMD_TIMEOUT=120
# WebSocket keepalive ping interval in seconds (0 disables).
PING_INTERVAL=20
# WebSocket ping timeout in seconds (0 disables).
PING_TIMEOUT=20

# Server root directory where run.bat and world/ live; required only for "uv run deploy",
# leave blank otherwise.
SERVER_DIR=
